/* ============================================================
   ОНБОРДИНГ — первое знакомство
   Показывается один раз. Хранится в localStorage.
   ============================================================ */

(function(){
  const KEY = 'tochka_opory_v1';
  const ONBOARD_FLAG = 'onboarded_v1';

  // Проверяем, показывали ли уже
  function alreadyShown(){
    try {
      const raw = localStorage.getItem(KEY);
      const data = raw ? JSON.parse(raw) : {};
      return !!data[ONBOARD_FLAG];
    } catch(e){ return false; }
  }

  function markShown(){
    try {
      const raw = localStorage.getItem(KEY);
      const data = raw ? JSON.parse(raw) : {};
      data[ONBOARD_FLAG] = true;
      localStorage.setItem(KEY, JSON.stringify(data));
    } catch(e){}
  }

  if (alreadyShown()) return;

  // --- Стили ---
  const style = document.createElement('style');
  style.textContent = `
    .ob-overlay{
      position:fixed; inset:0; z-index:9999;
      background:
        radial-gradient(1200px 600px at 10% -10%, rgba(124,92,255,.35), transparent 60%),
        radial-gradient(900px 500px at 100% 20%, rgba(74,214,200,.28), transparent 60%),
        radial-gradient(800px 600px at 50% 110%, rgba(255,92,138,.22), transparent 60%),
        #0b0b12;
      display:flex; align-items:center; justify-content:center;
      padding:24px; font-family:'Inter',system-ui,-apple-system,Segoe UI,Roboto,sans-serif;
      color:#f2f2f7; overflow-y:auto;
      animation:obFadeIn .4s ease;
    }
    @keyframes obFadeIn{from{opacity:0}to{opacity:1}}
    @keyframes obFadeOut{from{opacity:1}to{opacity:0}}
    .ob-overlay.closing{animation:obFadeOut .3s ease forwards}

    .ob-card{
      width:100%; max-width:560px;
      background:rgba(255,255,255,.05);
      border:1px solid rgba(255,255,255,.12);
      border-radius:24px; padding:40px 32px 32px;
      backdrop-filter:blur(20px);
      box-shadow:0 30px 80px rgba(0,0,0,.5);
      position:relative;
      animation:obSlideIn .5s cubic-bezier(.2,.8,.3,1);
    }
    @keyframes obSlideIn{from{opacity:0;transform:translateY(20px) scale(.98)}to{opacity:1;transform:none}}

    .ob-dots{
      display:flex; gap:8px; justify-content:center; margin-bottom:26px;
    }
    .ob-dot{
      width:8px; height:8px; border-radius:50%;
      background:rgba(255,255,255,.2); transition:.3s;
    }
    .ob-dot.active{
      width:26px; border-radius:999px;
      background:linear-gradient(90deg,#7c5cff,#4ad6c8);
    }

    .ob-emoji{
      font-size:64px; text-align:center; margin-bottom:20px; line-height:1;
      animation:obPop .5s ease;
    }
    @keyframes obPop{from{transform:scale(.6);opacity:0}to{transform:scale(1);opacity:1}}

    .ob-title{
      font-size:26px; font-weight:800; text-align:center;
      margin-bottom:12px; letter-spacing:-.01em; line-height:1.2;
    }
    .ob-title .grad{
      background:linear-gradient(135deg,#b8a6ff,#4ad6c8 50%,#ff5c8a);
      -webkit-background-clip:text; background-clip:text; color:transparent;
    }
    .ob-text{
      font-size:15px; color:#a1a1b5; text-align:center;
      line-height:1.6; margin-bottom:28px; max-width:440px; margin-left:auto; margin-right:auto;
    }

    .ob-actions{
      display:flex; gap:10px; flex-direction:column;
    }
    .ob-btn{
      width:100%; padding:14px 20px; border-radius:14px;
      font-size:15px; font-weight:700; cursor:pointer;
      border:1px solid transparent; font-family:inherit;
      transition:.2s; text-align:center;
    }
    .ob-btn:hover{transform:translateY(-1px)}
    .ob-btn-primary{
      background:linear-gradient(135deg,#7c5cff,#5f3dff); color:#fff;
      box-shadow:0 12px 30px rgba(124,92,255,.4);
    }
    .ob-btn-primary:hover{opacity:.95}
    .ob-btn-ghost{
      background:rgba(255,255,255,.06); color:#a1a1b5;
      border-color:rgba(255,255,255,.12);
    }
    .ob-btn-ghost:hover{background:rgba(255,255,255,.1); color:#f2f2f7}

    .ob-skip{
      position:absolute; top:16px; right:20px;
      font-size:13px; color:#a1a1b5; cursor:pointer;
      background:none; border:none; font-family:inherit;
      padding:6px 10px; border-radius:8px; transition:.2s;
    }
    .ob-skip:hover{color:#f2f2f7; background:rgba(255,255,255,.06)}

    /* Экран выбора */
    .ob-choices{display:flex; flex-direction:column; gap:12px; margin-bottom:22px}
    .ob-choice{
      padding:18px 20px; border-radius:16px; cursor:pointer;
      background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12);
      display:flex; gap:14px; align-items:center;
      transition:.2s; text-align:left; font-family:inherit; color:inherit;
      width:100%;
    }
    .ob-choice:hover{transform:translateY(-2px)}
    .ob-choice.fin:hover{border-color:rgba(74,214,200,.6); background:rgba(74,214,200,.1)}
    .ob-choice.psy:hover{border-color:rgba(124,92,255,.6); background:rgba(124,92,255,.1)}
    .ob-choice.sup:hover{border-color:rgba(255,92,138,.6); background:rgba(255,92,138,.1)}
    .ob-choice .ico{
      width:48px; height:48px; border-radius:14px; flex-shrink:0;
      display:grid; place-items:center; font-size:22px;
      background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.12);
    }
    .ob-choice .txt h4{font-size:15.5px; font-weight:800; margin-bottom:3px}
    .ob-choice .txt p{font-size:13px; color:#a1a1b5; line-height:1.4}

    @media (max-width:520px){
      .ob-card{padding:32px 22px 24px}
      .ob-title{font-size:22px}
      .ob-emoji{font-size:52px}
    }
  `;
  document.head.appendChild(style);

  // --- Состояние ---
  let step = 0;
  const total = 3;

  // --- Рендер ---
  const overlay = document.createElement('div');
  overlay.className = 'ob-overlay';
  overlay.innerHTML = `<div class="ob-card" id="obCard"></div>`;
  document.body.appendChild(overlay);

  const card = overlay.querySelector('#obCard');

  function closeAndGo(target){
    markShown();
    overlay.classList.add('closing');
    setTimeout(()=>{
      overlay.remove();
      if (target) window.location.href = target;
    }, 300);
  }

  function renderStep0(){
    card.innerHTML = `
      <button class="ob-skip" onclick="window.__obSkip()">Пропустить</button>
      <div class="ob-dots">
        <div class="ob-dot active"></div>
        <div class="ob-dot"></div>
        <div class="ob-dot"></div>
      </div>
      <div class="ob-emoji">💛</div>
      <div class="ob-title">Привет! Это <span class="grad">Точка опоры</span></div>
      <div class="ob-text">
        Бесплатное приложение для студентов. Здесь ты разберёшься с деньгами, эмоциями и получишь поддержку, когда тяжело. Без лекций и морализаторства.
      </div>
      <div class="ob-actions">
        <button class="ob-btn ob-btn-primary" id="obNext">Далее →</button>
      </div>
    `;
    card.querySelector('#obNext').onclick = () => { step = 1; render(); };
  }

  function renderStep1(){
    card.innerHTML = `
      <button class="ob-skip" onclick="window.__obSkip()">Пропустить</button>
      <div class="ob-dots">
        <div class="ob-dot"></div>
        <div class="ob-dot active"></div>
        <div class="ob-dot"></div>
      </div>
      <div class="ob-emoji">🎯</div>
      <div class="ob-title">Как это устроено</div>
      <div class="ob-text">
        Три модуля: <b style="color:#4ad6c8">Финансы</b>, <b style="color:#b8a6ff">Психология</b> и <b style="color:#ff9dba">Поддержка</b>. В каждом — короткие уроки по 10–15 минут, практика, тест и рефлексия.
      </div>
      <div class="ob-text" style="margin-top:-14px">
        Твой прогресс сохраняется на устройстве. Никакой регистрации, никакого спама.
      </div>
      <div class="ob-actions">
        <button class="ob-btn ob-btn-primary" id="obNext">Понятно →</button>
        <button class="ob-btn ob-btn-ghost" id="obBack">← Назад</button>
      </div>
    `;
    card.querySelector('#obNext').onclick = () => { step = 2; render(); };
    card.querySelector('#obBack').onclick = () => { step = 0; render(); };
  }

  function renderStep2(){
    card.innerHTML = `
      <div class="ob-dots">
        <div class="ob-dot"></div>
        <div class="ob-dot"></div>
        <div class="ob-dot active"></div>
      </div>
      <div class="ob-title">С чего начнём?</div>
      <div class="ob-text" style="margin-bottom:22px">
        Выбери то, что ближе сейчас. Потом сможешь переключаться между модулями свободно.
      </div>
      <div class="ob-choices">
        <button class="ob-choice fin" data-target="module-fin.html">
          <div class="ico">💰</div>
          <div class="txt">
            <h4>Финансы</h4>
            <p>Бюджет, накопления, подработка, безопасность</p>
          </div>
        </button>
        <button class="ob-choice psy" data-target="module-psy.html">
          <div class="ico">🧠</div>
          <div class="txt">
            <h4>Психология</h4>
            <p>Тревога, выгорание, прокрастинация, границы</p>
          </div>
        </button>
        <button class="ob-choice sup" data-target="module-sup.html">
          <div class="ico">🆘</div>
          <div class="txt">
            <h4>Поддержка</h4>
            <p>Горячие линии, скрипты, безопасный план</p>
          </div>
        </button>
      </div>
      <div class="ob-actions">
        <button class="ob-btn ob-btn-ghost" id="obSkipAll">Остаться на главной</button>
      </div>
    `;
    card.querySelectorAll('.ob-choice').forEach(btn => {
      btn.onclick = () => closeAndGo(btn.dataset.target);
    });
    card.querySelector('#obSkipAll').onclick = () => closeAndGo(null);
  }

  function render(){
    if (step === 0) renderStep0();
    else if (step === 1) renderStep1();
    else renderStep2();
  }

  // Глобальная функция пропуска
  window.__obSkip = () => closeAndGo(null);

  render();
})();